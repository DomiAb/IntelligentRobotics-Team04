{
    "description": "Slide the door from right to left, close the drawer, turn the switch on. One of the chains that test the goal switch, see run_goal_switch.bat. No blocks, scale and alpha of the paper per behavior. Make it with dynaguide_scripts/make_task.py",
    "env_setup": {
        "drawer": "open",
        "sliding_door": "right",
        "switch": "off",
        "green_light": "off",
        "blocks": {
            "red": "hidden",
            "blue": "hidden",
            "pink": "hidden"
        }
    },
    "reset_poses": "calvin_exp_configs_examples/reset_poses/initial_calvin_robot_states_right_side_midpoint.json",
    "max": 12,
    "steps": [
        {
            "name": "door_left",
            "poses": "articulated/door_left",
            "contrast_poses": "articulated/door_right",
            "scale": 1.5,
            "alpha": 30
        },
        {
            "name": "close_drawer",
            "poses": "articulated/drawer_close",
            "scale": 1,
            "alpha": 40
        },
        {
            "name": "switch_on",
            "poses": "articulated/switch_on",
            "scale": 1.5,
            "alpha": 30
        }
    ]
}