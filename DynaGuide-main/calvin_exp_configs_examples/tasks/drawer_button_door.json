{
    "description": "Three articulated behaviors in a row, no blocks: open the drawer, press the button so the green LED turns on, slide the door from left to right. Each step has the scale and alpha of the paper for its behavior (calvin_articulated_object.sh). Pressing the button in the drawer or the door step is recorded as a violation, \"on_avoid\" : \"end\" would end the rollout there. Make it with dynaguide_scripts/make_task.py",
    "env_setup": {
        "drawer": "closed",
        "sliding_door": "left",
        "switch": "off",
        "green_light": "off",
        "blocks": {
            "red": "hidden",
            "blue": "hidden",
            "pink": "hidden"
        }
    },
    "reset_poses": "calvin_exp_configs_examples/reset_poses/initial_calvin_robot_states_right_side_midpoint.json",
    "on_avoid": "record",
    "max": 12,
    "steps": [
        {
            "name": "open_drawer",
            "poses": "articulated/drawer_open",
            "contrast_poses": "articulated/drawer_close",
            "scale": 1,
            "alpha": 40,
            "avoid_behaviors": [
                "button_on",
                "button_off"
            ]
        },
        {
            "name": "button_on",
            "poses": "articulated/button_on",
            "scale": 1,
            "alpha": 30
        },
        {
            "name": "door_right",
            "poses": "articulated/door_right",
            "scale": 2,
            "alpha": 15,
            "avoid_behaviors": [
                "button_on",
                "button_off"
            ]
        }
    ]
}