{
    "description": "Open the drawer, pick up the blue block, put it in the drawer, close the drawer. One scene for every reset: door left, switch off, lights off, drawer closed, only the blue block at the right front corner of the table (x 0.30, y -0.12), away from where the reset poses put the hand. Every guidance condition shows that same scene (calvin_exp_configs_examples/scene_conditions/single_block_drawer.json, made with dynaguide_scripts/render_scene_conditions.py)",
    "env_setup": {
        "drawer": "closed",
        "sliding_door": "left",
        "switch": "off",
        "green_light": "off",
        "blocks": {
            "blue": {"place": "table_right", "offset": [0.0, -0.03], "yaw": 0.0},
            "red": "hidden",
            "pink": "hidden"
        }
    },
    "reset_poses": "calvin_exp_configs_examples/reset_poses/initial_calvin_robot_states_right_side_midpoint.json",
    "goal_sequence": [
        {
            "name": "open_drawer",
            "behaviors": ["drawer_open"],
            "pos_examples": "datasets/guidance_conditions/single_block_drawer/drawer_open_block_on_table.hdf5",
            "scale": 1,
            "alpha": 40,
            "switch": {
                "contrast_examples": "datasets/guidance_conditions/single_block_drawer/drawer_closed_block_on_table.hdf5"
            }
        },
        {
            "name": "pick_block",
            "behaviors": ["blue_lift"],
            "pos_examples": "datasets/guidance_conditions/single_block_drawer/block_lifted_drawer_open.hdf5",
            "scale": 1.5,
            "alpha": 30
        },
        {
            "name": "place_block_in_drawer",
            "where": {
                "drawer": "open",
                "blocks": {"blue": ["drawer", "released"]}
            },
            "pos_examples": "datasets/guidance_conditions/single_block_drawer/block_in_open_drawer_released.hdf5",
            "scale": 1.5,
            "alpha": 30
        },
        {
            "name": "close_drawer",
            "behaviors": ["drawer_close"],
            "where": {
                "blocks": {"blue": "drawer"}
            },
            "pos_examples": "datasets/guidance_conditions/single_block_drawer/drawer_closed_block_in_drawer.hdf5",
            "scale": 1,
            "alpha": 40
        }
    ]
}
