{
    "description": "Guidance conditions for open the drawer, pick up the blue block, put it in the drawer, close the drawer (calvin_exp_configs_examples/multigoal/single_block_drawer.json). Every condition shows the scene the experiment resets to: door left, switch off, lights off, only the blue block. Made with dynaguide_scripts/render_scene_conditions.py from the robot_poses collection",
    "scene": {
        "drawer": "closed",
        "sliding_door": "left",
        "switch": "off",
        "green_light": "off",
        "blocks": {
            "blue": {"place": "table_right", "offset": [0.0, -0.03], "yaw": 0.0},
            "red": "hidden",
            "pink": "hidden"
        }
    },
    "block": "blue",
    "sets": {
        "drawer_closed_block_on_table": {
            "poses": "datasets/robot_poses/ground_truth/drawer_close.hdf5",
            "joints": {"drawer": "pose"},
            "block": "start"
        },
        "drawer_open_block_on_table": {
            "poses": "datasets/robot_poses/ground_truth/drawer_open.hdf5",
            "joints": {"drawer": "pose"},
            "block": "start"
        },
        "block_lifted_drawer_open": {
            "poses": "datasets/robot_poses/blocks/block_lifted.hdf5",
            "joints": {"drawer": 0.18},
            "block": "pose",
            "pose_block": "same",
            "near_start": 0.25
        },
        "block_in_open_drawer_released": {
            "poses": "datasets/robot_poses/blocks/block_in_drawer_released.hdf5",
            "joints": {"drawer": "pose"},
            "block": "pose",
            "pose_block": "any"
        },
        "drawer_closed_block_in_drawer": {
            "poses": "datasets/robot_poses/ground_truth/drawer_close.hdf5",
            "joints": {"drawer": "pose"},
            "block": "drawer_center"
        }
    }
}
