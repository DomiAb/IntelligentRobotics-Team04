{
    "description": "Drawer, switch and button from a closed drawer, switch off and green light off, with conditions with blocks, without, and both. Guidance settings per experiment from paper_experiments/calvin_articulated_object.sh",
    "n_rollouts": 10,
    "horizon": 250,
    "scale": 1.5,
    "ss": 4,
    "alpha": 30,
    "base_policy": true,
    "keep_images": false,
    "experiments": {
        "drawer_open": {
            "config": "calvin_exp_configs_examples/experiments/drawer_open.json",
            "scale": 1,
            "alpha": 40,
            "conditions": {
                "blocks": "datasets/guidance_conditions/recombined_debug/drawer_open/drawer_open__door_*__switch_off__green_light_off.hdf5",
                "no_blocks": "datasets/guidance_conditions/recombined_debug_no_blocks/drawer_open/drawer_open__door_*__switch_off__green_light_off.hdf5",
                "both": [
                    "datasets/guidance_conditions/recombined_debug/drawer_open/drawer_open__door_*__switch_off__green_light_off.hdf5",
                    "datasets/guidance_conditions/recombined_debug_no_blocks/drawer_open/drawer_open__door_*__switch_off__green_light_off.hdf5"
                ]
            }
        },
        "drawer_close": {
            "config": "calvin_exp_configs_examples/experiments/drawer_close.json",
            "scale": 1,
            "alpha": 40,
            "conditions": {
                "blocks": "datasets/guidance_conditions/recombined_debug/drawer_close/drawer_closed__door_*__switch_off__green_light_off.hdf5",
                "no_blocks": "datasets/guidance_conditions/recombined_debug_no_blocks/drawer_close/drawer_closed__door_*__switch_off__green_light_off.hdf5",
                "both": [
                    "datasets/guidance_conditions/recombined_debug/drawer_close/drawer_closed__door_*__switch_off__green_light_off.hdf5",
                    "datasets/guidance_conditions/recombined_debug_no_blocks/drawer_close/drawer_closed__door_*__switch_off__green_light_off.hdf5"
                ]
            }
        },
        "switch_on": {
            "config": "calvin_exp_configs_examples/experiments/switch_on.json",
            "conditions": {
                "blocks": "datasets/guidance_conditions/recombined_debug/switch_on/drawer_closed__door_*__switch_on__green_light_off.hdf5",
                "no_blocks": "datasets/guidance_conditions/recombined_debug_no_blocks/switch_on/drawer_closed__door_*__switch_on__green_light_off.hdf5",
                "both": [
                    "datasets/guidance_conditions/recombined_debug/switch_on/drawer_closed__door_*__switch_on__green_light_off.hdf5",
                    "datasets/guidance_conditions/recombined_debug_no_blocks/switch_on/drawer_closed__door_*__switch_on__green_light_off.hdf5"
                ],
                "paper": "guidance_condition_switch_on_20.hdf5"
            }
        },
        "button_on": {
            "config": "calvin_exp_configs_examples/experiments/button_on.json",
            "scale": 1,
            "conditions": {
                "blocks": "datasets/guidance_conditions/recombined_debug/button_on/drawer_closed__door_*__switch_off__green_light_on.hdf5",
                "no_blocks": "datasets/guidance_conditions/recombined_debug_no_blocks/button_on/drawer_closed__door_*__switch_off__green_light_on.hdf5",
                "both": [
                    "datasets/guidance_conditions/recombined_debug/button_on/drawer_closed__door_*__switch_off__green_light_on.hdf5",
                    "datasets/guidance_conditions/recombined_debug_no_blocks/button_on/drawer_closed__door_*__switch_off__green_light_on.hdf5"
                ],
                "debug_all": "datasets/guidance_conditions/debug_all/button_on.hdf5"
            }
        }
    }
}