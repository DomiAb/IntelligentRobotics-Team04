{
    "description": "Part 1 of 2, for running on two machines at once: drawer_open and switch_on. Each part has 9 tasks, 7 guided and 2 base policy. The seeds are those of the plan in one piece, so splitting changes nothing. Start: closed drawer (open for drawer_close), switch off, green light off. Conditions with blocks, without, and both. Guidance settings per experiment from paper_experiments/calvin_articulated_object.sh",
    "n_rollouts": 10,
    "horizon": 250,
    "scale": 1.5,
    "ss": 4,
    "alpha": 30,
    "base_policy": true,
    "keep_images": false,
    "experiments": {
        "drawer_open": {
            "config": "calvin_exp_configs_examples/experiments/drawer_open.json",
            "scale": 1,
            "alpha": 40,
            "conditions": {
                "blocks": "datasets/guidance_conditions/recombined_debug/drawer_open/drawer_open__door_*__switch_off__green_light_off.hdf5",
                "no_blocks": "datasets/guidance_conditions/recombined_debug_no_blocks/drawer_open/drawer_open__door_*__switch_off__green_light_off.hdf5",
                "both": [
                    "datasets/guidance_conditions/recombined_debug/drawer_open/drawer_open__door_*__switch_off__green_light_off.hdf5",
                    "datasets/guidance_conditions/recombined_debug_no_blocks/drawer_open/drawer_open__door_*__switch_off__green_light_off.hdf5"
                ]
            },
            "seed": 0
        },
        "switch_on": {
            "config": "calvin_exp_configs_examples/experiments/switch_on.json",
            "conditions": {
                "blocks": "datasets/guidance_conditions/recombined_debug/switch_on/drawer_closed__door_*__switch_on__green_light_off.hdf5",
                "no_blocks": "datasets/guidance_conditions/recombined_debug_no_blocks/switch_on/drawer_closed__door_*__switch_on__green_light_off.hdf5",
                "both": [
                    "datasets/guidance_conditions/recombined_debug/switch_on/drawer_closed__door_*__switch_on__green_light_off.hdf5",
                    "datasets/guidance_conditions/recombined_debug_no_blocks/switch_on/drawer_closed__door_*__switch_on__green_light_off.hdf5"
                ],
                "paper": "guidance_condition_switch_on_20.hdf5"
            },
            "seed": 2
        }
    }
}